PYTHON_ENV=development
PYTHON_LOG_LEVEL=info
PYTHON_HOST=0.0.0.0
PYTHON_PORT=8000
PYTHON_RETRIEVAL_BACKEND=hybrid
PYTHON_INGESTION_BACKEND=sqlite
PYTHON_INGESTION_SQLITE_PATH=python/.runtime/ingestion.db
PYTHON_INGESTION_WORKER_POLL_MS=1000
PYTHON_INGESTION_WORKER_BATCH_SIZE=10
PYTHON_QDRANT_URL=http://127.0.0.1:6333
PYTHON_QDRANT_API_KEY=
PYTHON_QDRANT_COLLECTION=ragent_python_chunks
PYTHON_QDRANT_TIMEOUT_MS=5000
PYTHON_QDRANT_VECTOR_SIZE=8
PYTHON_RERANKER_BACKEND=auto
PYTHON_RERANKER_TIMEOUT_MS=10000
PYTHON_BGE_RERANKER_URL=http://127.0.0.1:8091/v1/rerank
PYTHON_RERANK_CANDIDATE_COUNT=20
PYTHON_RERANK_RETRIEVAL_WEIGHT=0.3
PYTHON_RERANK_MODEL_WEIGHT=0.7
PYTHON_LLM_PROVIDER=auto
PYTHON_LLM_MODEL=
PYTHON_LLM_FALLBACK_CHAIN=openai,anthropic,ollama,mock
PYTHON_LLM_MAX_INPUT_TOKENS=16000
PYTHON_LLM_MAX_OUTPUT_TOKENS=2000
PYTHON_LLM_TEMPERATURE=0.2
# OpenAI-compatible generation provider (vendor-agnostic).
# Examples (set OPENAI_BASE_URL + PYTHON_LLM_MODEL to switch vendor):
#   OpenAI proper      : OPENAI_BASE_URL=               PYTHON_LLM_MODEL=gpt-4o-mini
#   Alibaba DashScope  : OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1   PYTHON_LLM_MODEL=qwen-plus
#   Self-hosted vLLM   : OPENAI_BASE_URL=http://127.0.0.1:8080/v1   PYTHON_LLM_MODEL=<deployed>
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
OLLAMA_BASE_URL=
