# Ragent docker-compose configuration.
#
#   1. Copy this file to `.env.docker` (gitignored):
#         cp .env.docker.example .env.docker
#   2. Edit the values below as needed (most defaults already work for
#      a local demo).
#   3. Bring the stack up:
#         docker compose up
#      Optionally enable the Qdrant vector store:
#         docker compose --profile qdrant up
#
# `docker-compose.yml` already wires service-to-service URLs (e.g.
# PYTHON_API_BASE_URL=http://python-api:8000) and exposes host ports,
# so you should NOT have to set those here.

# ── Authentication ──────────────────────────────────────────────────
# Demo defaults to a local "mock" identity provider so you can sign in
# immediately without configuring OIDC. Flip these to your IdP when you
# move beyond the demo (see README "OIDC" section).
AUTH_PROVIDER_MODE=mock
AUTH_MOCK_FALLBACK_ENABLED=true
# CHANGE THIS before exposing the stack on a network — any 32+ char
# random string works (`openssl rand -hex 32`).
AUTH_SESSION_SECRET=change-me-to-a-long-random-string-before-anything-real

# ── LLM provider ────────────────────────────────────────────────────
# Default leaves OPENAI_API_KEY empty, which makes the generation
# adapter resolver fall back to a deterministic mock — useful for
# screenshots / dry runs without burning real LLM credits.
#
# To wire a real OpenAI-compatible vendor (OpenAI / DashScope / vLLM /
# Moonshot / …), uncomment these three and set the appropriate values:
#
#   OPENAI_API_KEY=sk-...
#   OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   PYTHON_LLM_MODEL=qwen-plus
#
# `PYTHON_LLM_FALLBACK_CHAIN` controls which adapters the resolver
# tries in order; mock is the safe terminal fallback.
PYTHON_LLM_FALLBACK_CHAIN=openai,mock

# ── Retrieval backend ───────────────────────────────────────────────
# `bm25` keeps everything in-memory; the ecommerce module + demo
# corpus work without any external vector store.
#
# To use Qdrant, switch to `hybrid` AND bring up the qdrant profile:
#   PYTHON_RETRIEVAL_BACKEND=hybrid
#   docker compose --profile qdrant up
PYTHON_RETRIEVAL_BACKEND=bm25

# ── Host port overrides (optional) ──────────────────────────────────
# Uncomment to bind on different host ports if 3000 / 8000 / 6333 /
# 6334 are already taken on your machine.
# RAGENT_WEB_HOST_PORT=3000
# RAGENT_PYTHON_HOST_PORT=8000
# RAGENT_QDRANT_HOST_PORT=6333
# RAGENT_QDRANT_GRPC_HOST_PORT=6334
