# Ragent docker-compose configuration.
#
#   1. Copy this file to `.env.docker` (gitignored):
#         cp .env.docker.example .env.docker
#   2. Edit the values below as needed (most defaults already work for
#      a local demo).
#   3. Bring the stack up:
#         docker compose up                           # web + python-api
#         docker compose --profile qdrant up          # also Qdrant
#         docker compose --profile postgres up        # also Postgres
#         docker compose --profile qdrant \
#                       --profile postgres up         # everything
#
# `docker-compose.yml` already wires service-to-service URLs (e.g.
# PYTHON_API_BASE_URL=http://python-api:8000) and exposes host ports,
# so you should NOT have to set those here.

# ── Authentication ──────────────────────────────────────────────────
# Two modes are supported (see README "Authentication"):
#
#   AUTH_PROVIDER_MODE=oidc   real OIDC IdP (Auth0 / Okta / Google /
#                             Microsoft Entra / Keycloak / …). MUST be
#                             used for any deployment people can reach.
#   AUTH_PROVIDER_MODE=mock   local-only mock identity provider with
#                             a built-in role picker. Useful for
#                             screenshots / first-boot demos. Refuses
#                             to enable in production OIDC mode.
#
# This config block is laid out in the recommended order: OIDC first
# (uncomment to use), mock second (default for first-boot demo only).

# --- OIDC (recommended for any shared deployment) ---
# AUTH_PROVIDER_MODE=oidc
#
# Discovery only needs the issuer URL; the BFF fetches
# `<issuer>/.well-known/openid-configuration` and resolves the
# authorize / token / userinfo endpoints automatically.
# AUTH_OIDC_ISSUER=https://YOUR-TENANT.auth0.com/
# AUTH_OIDC_CLIENT_ID=
# AUTH_OIDC_CLIENT_SECRET=
#
# Optional: map provider claims to Ragent's session fields. Defaults
# work for most IdPs; override when claim names differ.
# AUTH_OIDC_USER_ID_CLAIM=sub
# AUTH_OIDC_NAME_CLAIM=name
# AUTH_OIDC_ROLE_CLAIM=role
# AUTH_OIDC_TENANT_CLAIM=tenant_id
# AUTH_OIDC_ORG_CLAIM=org_id
# AUTH_OIDC_ADMIN_ROLE_VALUES=admin,owner
# AUTH_OIDC_DEFAULT_TENANT=tenant_default
# AUTH_OIDC_DEFAULT_ORG=org_default

# --- Mock identity provider (demo only) ---
# Default for a first-boot demo. When NODE_ENV=production AND
# AUTH_PROVIDER_MODE=oidc the BFF FORCES mock fallback off and rejects
# `POST /api/auth/session` with 403 — so leaving these here cannot
# accidentally expose the mock endpoints once you flip to OIDC.
AUTH_PROVIDER_MODE=mock
AUTH_MOCK_FALLBACK_ENABLED=true
# CHANGE THIS before exposing the stack on a network — any 32+ char
# random string works (`openssl rand -hex 32`).
AUTH_SESSION_SECRET=change-me-to-a-long-random-string-before-anything-real

# ── Platform state persistence ──────────────────────────────────────
# Where the BFF stores conversations, messages, traces, ingestion
# tasks, knowledge bases, settings, mappings, sample questions, intents
# and users. Three backends are supported:
#
#   json     (default) flat JSON file under `.data/` inside the web
#            container. Persists across restarts because docker-compose
#            mounts a named volume, but tied to a single container.
#   sqlite   Embedded sqlite database under `.data/`. Same volume.
#   postgres External Postgres. Required if you want to point multiple
#            web replicas at the same state, or run a managed DB.
#
# To use the bundled `postgres` service (under `--profile postgres`):
#   1. Uncomment the two lines below.
#   2. Bring the stack up with:
#         docker compose --profile postgres up
# The default URL points at the in-network `postgres` service with the
# credentials defined in `docker-compose.yml`; override it if you have
# an external Postgres.
#
# TS_PLATFORM_STATE_BACKEND=postgres
# TS_PLATFORM_STATE_DATABASE_URL=postgres://ragent:ragent-dev@postgres:5432/ragent
#
# Optional: override the table / row key if sharing a database with
# another app. Defaults are platform_state / "default".
# TS_PLATFORM_STATE_POSTGRES_TABLE=platform_state
# TS_PLATFORM_STATE_POSTGRES_KEY=default

# ── LLM provider ────────────────────────────────────────────────────
# Default leaves OPENAI_API_KEY empty, which makes the generation
# adapter resolver fall back to a deterministic mock — useful for
# screenshots / dry runs without burning real LLM credits.
#
# To wire a real OpenAI-compatible vendor (OpenAI / DashScope / vLLM /
# Moonshot / …), uncomment these three and set the appropriate values:
#
#   OPENAI_API_KEY=sk-...
#   OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   PYTHON_LLM_MODEL=qwen-plus
#
# `PYTHON_LLM_FALLBACK_CHAIN` controls which adapters the resolver
# tries in order; mock is the safe terminal fallback.
PYTHON_LLM_FALLBACK_CHAIN=openai,mock

# ── Retrieval backend ───────────────────────────────────────────────
# `bm25` keeps everything in-memory; the ecommerce module + demo
# corpus work without any external vector store.
#
# To use Qdrant, switch to `hybrid` AND bring up the qdrant profile:
#   PYTHON_RETRIEVAL_BACKEND=hybrid
#   docker compose --profile qdrant up
PYTHON_RETRIEVAL_BACKEND=bm25

# ── Host port overrides (optional) ──────────────────────────────────
# Uncomment to bind on different host ports if 3000 / 8000 / 6333 /
# 6334 / 5432 are already taken on your machine.
# RAGENT_WEB_HOST_PORT=3000
# RAGENT_PYTHON_HOST_PORT=8000
# RAGENT_QDRANT_HOST_PORT=6333
# RAGENT_QDRANT_GRPC_HOST_PORT=6334
# RAGENT_POSTGRES_HOST_PORT=5432
